# Backend (Maven / Spring Boot)
backend/target/
backend/*.log
backend/HELP.md
# backend/.mvn/ is NOT ignored - it's the Maven Wrapper (mvnw's jar + config), meant to be
# committed so a build works with no local Maven install. It was wrongly ignored here, which
# silently broke every Dockerfile/CI build that runs `mvnw` in a fresh clone (no local .mvn/
# cache to fall back on, unlike a machine that already had it) - see docker/backend.Dockerfile.

# Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local

# Env files (never commit real secrets)
.env
*.env
!.env.example
backend/.env
frontend/.env

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Claude Code local settings (per-machine permission grants, not app config)
.claude/settings.local.json

# Logs
*.log
npm-debug.log*
